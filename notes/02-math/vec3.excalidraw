      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "方向 = 单位向量 v / |v|：长度归一化为 1，只保留方向",
      "roughness": 1,
      "roundness": null,
      "seed": 10974819,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "方向 = 单位向量 v / |v|：长度归一化为 1，只保留方向",
      "textAlign": "left",
      "updated": 1794466435731,
