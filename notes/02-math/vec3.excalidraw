      "verticalAlign": "top"
    },
    {
      "id": "n-formula",
      "type": "text",
      "x": 60,
      "y": 675,
      "width": 1100,
      "height": 26,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aH",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "u·v = ux·vx + uy·vy + uz·vz = |u||v|cosθ —— 判断方向/夹角；u×v 垂直于 u、v（右手定则），反交换律：u×v = −(v×u)",
      "roughness": 1,
      "roundness": null,
      "seed": 1193468124,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "u·v = ux·vx + uy·vy + uz·vz = |u||v|cosθ —— 判断方向/夹角；u×v 垂直于 u、v（右手定则），反交换律：u×v = −(v×u)",
      "textAlign": "left",
      "updated": 1794466763938,
      "version": 1,
      "versionNonce": 786466342,
      "verticalAlign": "top"
    },
    {
      "id": "n-pitfalls",
      "type": "text",
      "x": 60,
      "y": 715,
      "width": 1100,
      "height": 26,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aI",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "踩坑：① 用 double 不用 float（累积误差出噪点）② 归一化零向量会除零 → NaN，先 near_zero() 判断 ③ 叉积顺序反了法线反向（该亮的地方黑）",
      "roughness": 1,
      "roundness": null,
      "seed": 2055252469,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "踩坑：① 用 double 不用 float（累积误差出噪点）② 归一化零向量会除零 → NaN，先 near_zero() 判断 ③ 叉积顺序反了法线反向（该亮的地方黑）",
      "textAlign": "left",
      "updated": 1794466763938,
      "version": 1,
      "versionNonce": 921778625,
      "verticalAlign": "top"
    }
