      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "叉乘计算公式（3×3 行列式展开）：",
      "textAlign": "left",
      "updated": 1794469000000,
      "version": 1,
      "versionNonce": 131379999,
      "verticalAlign": "top"
    },
    {
      "id": "t-d1",
      "type": "text",
      "x": 860,
      "y": 1274,
      "width": 500,
      "height": 66,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "b0R",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "        | i  j  k  |\na × b = | ax ay az |\n        | bx by bz |",
      "roughness": 1,
      "roundness": null,
      "seed": 148947257,
      "strokeColor": "#212529",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "        | i  j  k  |\na × b = | ax ay az |\n        | bx by bz |",
      "textAlign": "left",
      "updated": 1794469000000,
      "version": 1,
      "versionNonce": 141715580,
      "verticalAlign": "top"
    },
    {
      "id": "t-d2",
      "type": "text",
      "x": 860,
      "y": 1348,
      "width": 860,
      "height": 22,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 15,
      "frameId": null,
      "groupIds": [],
      "index": "b0S",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "= i·(ay·bz − az·by) − j·(ax·bz − az·bx) + k·(ax·by − ay·bx)",
      "roughness": 1,
      "roundness": null,
      "seed": 339477368,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "= i·(ay·bz − az·by) − j·(ax·bz − az·bx) + k·(ax·by − ay·bx)",
      "textAlign": "left",
      "updated": 1794469000000,
      "version": 1,
      "versionNonce": 272677687,
      "verticalAlign": "top"
    },
    {
      "id": "t-d3",
      "type": "text",
      "x": 860,
      "y": 1382,
      "width": 860,
      "height": 20,
      "angle": 0,
      "autoResize": true,
