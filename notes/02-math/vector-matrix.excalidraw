      "groupIds": [],
      "index": "b0T",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "x 分量 = ay·bz − az·by      y 分量 = az·bx − ax·bz（带负号）      z 分量 = ax·by − ay·bx",
      "roughness": 1,
      "roundness": null,
      "seed": 400987810,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "x 分量 = ay·bz − az·by      y 分量 = az·bx − ax·bz（带负号）      z 分量 = ax·by − ay·bx",
      "textAlign": "left",
      "updated": 1794469000000,
      "version": 1,
      "versionNonce": 889698557,
      "verticalAlign": "top"
    },
    {
