      "frameId": null,
      "groupIds": [],
      "index": "b06",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "θ：与 +z 轴夹角；φ：xy 平面方位角",
      "roughness": 1,
      "roundness": null,
      "seed": 1669394306,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "θ：与 +z 轴夹角；φ：xy 平面方位角",
      "textAlign": "left",
      "updated": 1794467866045,
