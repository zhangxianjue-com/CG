    },
    {
      "id": "d-note",
      "type": "text",
      "x": 1255,
      "y": 1005,
      "width": 220,
      "height": 20,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
