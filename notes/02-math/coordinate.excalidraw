      "verticalAlign": "top"
    },
    {
      "id": "f-formula",
      "type": "text",
      "x": 60,
      "y": 1095,
      "width": 1200,
      "height": 26,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "b07",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "极坐标 ↔ 直角坐标：x = r·cosθ，y = r·sinθ；r = √(x²+y²)，θ = atan2(y, x)      球坐标：x = r·sinθ·cosφ，y = r·sinθ·sinφ，z = r·cosθ",
      "roughness": 1,
      "roundness": null,
      "seed": 1285838756,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "极坐标 ↔ 直角坐标：x = r·cosθ，y = r·sinθ；r = √(x²+y²)，θ = atan2(y, x)      球坐标：x = r·sinθ·cosφ，y = r·sinθ·sinφ，z = r·cosθ",
      "textAlign": "left",
      "updated": 1794467817637,
      "version": 1,
      "versionNonce": 428001134,
      "verticalAlign": "top"
    },
    {
      "id": "f-pit",
      "type": "text",
      "x": 60,
      "y": 1135,
      "width": 1200,
      "height": 26,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "b08",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "踩坑：① 图形学默认右手系（z 出屏），左右手系只差 z 方向 ② 球坐标 θ 有两种定义（与 +z 夹角 / 与 xy 平面夹角），用前先确认 ③ atan2(y, x) 参数顺序易写反",
      "roughness": 1,
      "roundness": null,
      "seed": 497331833,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
