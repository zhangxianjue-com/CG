    {
      "id": "t-code",
      "type": "text",
      "x": 60,
      "y": 400,
      "width": 720,
      "height": 100,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aB",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Color screen_pixels[W][H];                        // 屏幕缓冲：每像素一个颜色\nfor (int y = 0; y < H; y++)                       // 遍历每一行\n    for (int x = 0; x < W; x++)                   // 遍历每一列\n        screen_pixels[x][y] = RenderPixel(x, y);  // 核心：算这个像素的颜色\npresent(screen_pixels);                           // 把缓冲显示到屏幕",
      "roughness": 1,
      "roundness": null,
      "seed": 806690912,
      "strokeColor": "#212529",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Color screen_pixels[W][H];                        // 屏幕缓冲：每像素一个颜色\nfor (int y = 0; y < H; y++)                       // 遍历每一行\n    for (int x = 0; x < W; x++)                   // 遍历每一列\n        screen_pixels[x][y] = RenderPixel(x, y);  // 核心：算这个像素的颜色\npresent(screen_pixels);                           // 把缓冲显示到屏幕",
      "textAlign": "left",
      "updated": 1794468000000,
      "version": 1,
      "versionNonce": 310716653,
      "verticalAlign": "top"
    },
